    },
    {
      "name": "Bookings",
      "description": "Booking endpoints require authentication (guest token from Auth). Create → List → Cancel is the recommended order.",
      "item": [
        {
          "name": "POST Create booking",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"propertySlug\": \"crestview-boutique-hotel\",\n  \"roomId\": \"deluxe\",\n  \"checkIn\": \"{{checkIn}}\",\n  \"checkOut\": \"{{checkOut}}\",\n  \"guests\": 2,\n  \"airportPickup\": false,\n  \"paymentMethod\": \"card\",\n  \"requests\": \"Late check-in if possible\",\n  \"guest\": {\n    \"firstName\": \"Test\",\n    \"lastName\": \"Guest\",\n    \"email\": \"{{registeredEmail}}\",\n    \"phone\": \"+2348012345678\"\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/bookings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings"]
            },
            "description": "Create a booking (server-priced). Requires Bearer token. Example uses property `crestview-boutique-hotel`, room `deluxe`. Pre-request sets future check-in/out dates to reduce conflicts. paymentMethod: card | bank | ussd."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const startOffset = 30 + Math.floor(Math.random() * 200);",
                  "const nights = 3;",
                  "const checkIn = new Date();",
                  "checkIn.setUTCHours(0, 0, 0, 0);",
                  "checkIn.setUTCDate(checkIn.getUTCDate() + startOffset);",
                  "const checkOut = new Date(checkIn);",
                  "checkOut.setUTCDate(checkOut.getUTCDate() + nights);",
                  "pm.collectionVariables.set('checkIn', checkIn.toISOString().slice(0, 10));",
                  "pm.collectionVariables.set('checkOut', checkOut.toISOString().slice(0, 10));",
                  "if (!pm.collectionVariables.get('registeredEmail')) {",
                  "  pm.collectionVariables.set('registeredEmail', 'guest@example.com');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Returns booking and saves reference', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('data');",
                  "  pm.expect(json.data).to.have.property('reference');",
                  "  pm.collectionVariables.set('bookingReference', json.data.reference);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET List bookings",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/bookings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings"],
              "query": [
                {
                  "key": "status",
                  "value": "upcoming",
                  "disabled": true,
                  "description": "Optional: upcoming | confirmed | completed | cancelled | no_show"
                }
              ]
            },
            "description": "List bookings visible to the authenticated user (guest: own bookings; host/admin scoped by role). Optional `status` filter."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Returns booking list', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('count');",
                  "  pm.expect(json).to.have.property('data');",
                  "  pm.expect(json.data).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH Cancel booking",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/bookings/{{bookingReference}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings", "{{bookingReference}}", "cancel"]
            },
            "description": "Cancel an upcoming/confirmed booking by reference (e.g. JS-8F2K1Q). Uses `{{bookingReference}}` saved by Create booking. Only the owner (or admin/authorized host) can cancel; only upcoming bookings can be cancelled."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Booking cancelled', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('data');",
                  "  pm.expect(json.data.status).to.eql('cancelled');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Host",
      "description": "Host endpoints require a host or admin account. A guest token will receive 403 Forbidden.",
      "item": [
        {
          "name": "GET Host payouts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/host/payouts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "host", "payouts"]
            },
            "description": "Get payout records for the authenticated host (or admin). Requires Bearer token with role `host` or `admin`. With a guest token this returns 403."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 (host/admin) or 401/403 (missing/guest token)', function () {",
                  "  pm.expect([200, 401, 403]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  pm.test('Returns payout data', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.be.an('object');",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
