# ---------------------------------------------------------------------------
# Client (apps/client/.env.local) - local testing values
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000

# Support/admin contact number (international format, digits only, no +). Used for WhatsApp (wa.me) and tel links.
NEXT_PUBLIC_SUPPORT_WHATSAPP_NUMBER=2348000000000

# Never put database passwords, service keys, or secrets in NEXT_PUBLIC_* vars.

# ---------------------------------------------------------------------------
# Server (apps/server/.env) - local testing values
# Copy/adapt as needed for local DB-backed testing. For production/Aiven, replace with real infra values.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:3000

# demo = in-memory sample data (local only)
# postgres = PostgreSQL persistence (required in production, Aiven-compatible)
DATA_BACKEND=postgres

# PostgreSQL (local testing)
# Use DATABASE_URL or discrete PG* variables. For Aiven/managed TLS, provide the CA certificate path.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/josstay_local
# PGHOST=127.0.0.1
# PGPORT=5432
# PGDATABASE=josstay_local
# PGUSER=postgres
# PGPASSWORD=postgres
DATABASE_CA_CERT_PATH=/path/to/aiven-postgres-ca.pem
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Redis / Valkey (optional for local testing unless Redis-backed features are exercised)
REDIS_URL=redis://127.0.0.1:6379
REDIS_CA_CERT_PATH=/path/to/aiven-redis-ca.pem
REDIS_TLS_REJECT_UNAUTHORIZED=true

# Generate with: openssl rand -base64 48 (use a strong secret in production)
JWT_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef
# Access tokens are short-lived in production by default (15m) when unset.
ACCESS_TOKEN_EXPIRES_IN=15m
# Backward-compatible alias read by the server if ACCESS_TOKEN_EXPIRES_IN is empty.
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
REFRESH_TOKEN_COOKIE_NAME=josstay_refresh
# Leave empty for environment-based defaults (secure in production).
AUTH_COOKIE_SECURE=false
# Leave empty for environment-based defaults (none in production for cross-origin cookies, lax in development).
AUTH_COOKIE_SAMESITE=lax
BCRYPT_ROUNDS=12

# Set to 1 when running behind Render/a proxy so rate limits see real IPs.
TRUST_PROXY=0
API_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# Optional: used by `npm --workspace @josstay/server run db:seed`
# to attach the seeded JS-8F2K1Q / JS-4M7P2D bookings to a real guest.
SEED_GUEST_EMAIL=demo@josstay.app

# Optional: used by `npm --workspace @josstay/server run db:create-user`
USER_EMAIL=host@example.com
USER_PASSWORD=replace-with-8-to-72-character-password
USER_NAME=JosStay Host
USER_ROLE=host

# ---------------------------------------------------------------------------
# Integrations (planned / in progress) - local/test placeholders
# ---------------------------------------------------------------------------
# Paystack: initialize/verify transactions server-side and process webhooks idempotently.
# Public key may be used client-side for approved checkout flows; secret/webhook keys are server-only.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxx
PAYSTACK_SECRET_KEY=sk_test_xxx

# Brevo (transactional email): server-only.
BREVO_API_KEY=xkeysib_replace_me
BREVO_SENDER_EMAIL=no-reply@example.com
BREVO_SENDER_NAME=JosStay

# WhatsApp / messaging (optional)
WHATSAPP_TOKEN=wa_token_replace_me
WHATSAPP_PHONE_NUMBER_ID=123456789012345

# Cloudinary (media/uploads): prefer server-signed uploads; keep secrets server-only.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=cloudinary_secret_replace_me
# Optional alternative single URL format:
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Google sign-in (client ID is public; used by web client + verified by API)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=1234567890-example.apps.googleusercontent.com
GOOGLE_CLIENT_ID=1234567890-example.apps.googleusercontent.com
