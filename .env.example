# ---------------------------------------------------------------------------
# Client (apps/client/.env.local)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000

# Support/admin contact number (international format, digits only, no +). Used for WhatsApp (wa.me) and tel links.
NEXT_PUBLIC_SUPPORT_WHATSAPP_NUMBER=2348000000000

# Never put database passwords, service keys, or secrets in NEXT_PUBLIC_* vars.

# ---------------------------------------------------------------------------
# Server (apps/server/.env)
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:3000

# demo = in-memory sample data (local only)
# postgres = PostgreSQL persistence (required in production, Aiven-compatible)
DATA_BACKEND=demo

# PostgreSQL (Aiven)
# Use DATABASE_URL or discrete PG* variables. For Aiven, provide the CA certificate path.
DATABASE_URL=
# PGHOST=
# PGPORT=5432
# PGDATABASE=
# PGUSER=
# PGPASSWORD=
DATABASE_CA_CERT_PATH=certs/aiven-ca.pem
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Redis (Aiven)
# Aiven Redis typically uses a rediss:// URL and a CA certificate.
REDIS_URL=
REDIS_CA_CERT_PATH=certs/aiven-ca.pem
REDIS_TLS_REJECT_UNAUTHORIZED=true

# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Set to 1 when running behind Render/a proxy so rate limits see real IPs.
TRUST_PROXY=0
API_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# Optional: used by `npm --workspace @josstay/server run db:seed`
# to attach the seeded JS-8F2K1Q / JS-4M7P2D bookings to a real guest.
SEED_GUEST_EMAIL=demo@josstay.app

# Optional: used by `npm --workspace @josstay/server run db:create-user`
USER_EMAIL=host@example.com
USER_PASSWORD=replace-with-8-to-72-character-password
USER_NAME=JosStay Host
USER_ROLE=host

# ---------------------------------------------------------------------------
# Integrations — planned
# ---------------------------------------------------------------------------
# Paystack: public key (pk_*) may be used client-side for checkout initialization;
# secret key (sk_*) is server-only for verification, charges and webhooks.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxx
PAYSTACK_SECRET_KEY=sk_test_xxx

BREVO_API_KEY=xkeysib-xxx
WHATSAPP_TOKEN=xxx
WHATSAPP_PHONE_NUMBER_ID=xxx
GOOGLE_CLIENT_ID=xxx
CLOUDINARY_URL=cloudinary://xxx
