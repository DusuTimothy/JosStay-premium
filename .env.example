# ---------------------------------------------------------------------------
# Client (apps/client/.env.local)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000

# Never put Supabase service-role keys in the client or any NEXT_PUBLIC_* var.

# ---------------------------------------------------------------------------
# Server (apps/server/.env)
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:3000

# demo = in-memory sample data (local only)
# supabase = Postgres persistence (required in production)
DATA_BACKEND=demo

# Supabase project settings (Dashboard → Project Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# SERVER ONLY. Bypasses RLS. Never expose in the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Set to 1 when running behind Render/a proxy so rate limits see real IPs.
TRUST_PROXY=0
API_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# Optional: used by `npm --workspace @josstay/server run db:seed`
# to attach the seeded JS-8F2K1Q / JS-4M7P2D bookings to a real guest.
SEED_GUEST_EMAIL=demo@josstay.app

# Optional: used by `npm --workspace @josstay/server run db:create-user`
USER_EMAIL=host@example.com
USER_PASSWORD=replace-with-a-12-character-password
USER_NAME=JosStay Host
USER_ROLE=host

# ---------------------------------------------------------------------------
# Integrations — planned
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
PAYSTACK_SECRET_KEY=pk_test_xxx
BREVO_API_KEY=xkeysib-xxx
WHATSAPP_TOKEN=xxx
WHATSAPP_PHONE_NUMBER_ID=xxx
GOOGLE_CLIENT_ID=xxx
CLOUDINARY_URL=cloudinary://xxx
