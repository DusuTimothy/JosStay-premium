{
  "name": "josstay-premium",
  "version": "1.0.0",
  "private": true,
  "description": "JosStay Premium — mobile-first accommodation booking for Jos, Plateau State.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,magenta \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "npm --workspace @josstay/client run dev",
    "dev:server": "npm --workspace @josstay/server run dev",
    "build": "npm --workspace @josstay/client run build",
    "start": "npm --workspace @josstay/client run start",
    "lint": "npm --workspace @josstay/client run lint"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
